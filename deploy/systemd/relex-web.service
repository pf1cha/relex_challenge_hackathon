[Unit]
Description=Relex web application
Requires=relex-migrate.service relex-qdrant.service
After=relex-migrate.service relex-qdrant.service
PartOf=relex.target

[Service]
Type=simple
User=root
WorkingDirectory=/mnt/relex-kai
EnvironmentFile=/etc/relex/relex.env
Environment=PYTHONPATH=/mnt/relex-kai/backend
ExecStart=/mnt/relex-kai/.tools/miniforge3/envs/relex/bin/python -m uvicorn app.main:production_app --factory --host 127.0.0.1 --port 18080 --no-access-log
Restart=on-failure
RestartSec=3

[Install]
WantedBy=relex.target
