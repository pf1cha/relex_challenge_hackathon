# Add your key to the private .env, never commit it.
OPENAI_API_KEY=
RELEX_MODEL_BASE_URL=https://api.openai.com/v1
RELEX_MODEL_NAME=gpt-5.4-mini
RELEX_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RELEX_EMBEDDING_MODEL=text-embedding-v4
# Optional per-service key overrides; blank values fall back to OPENAI_API_KEY.
RELEX_MODEL_API_KEY=
# Optional dedicated local privacy model; blank values fall back to the general model.
RELEX_PRIVACY_MODEL_BASE_URL=
RELEX_PRIVACY_MODEL_NAME=
RELEX_PRIVACY_MODEL_API_KEY=
RELEX_EMBEDDING_API_KEY=
# Service connections are selected after isolated runtime feasibility verification.
RELEX_DATABASE_URL=
# Restricted privacy/admin/worker credential. If omitted, the runtime uses the
# ordinary URL and reports that database-role isolation is not configured.
RELEX_RESTRICTED_DATABASE_URL=
RELEX_QDRANT_URL=
RELEX_QDRANT_API_KEY=

# Native PostgreSQL; backend only. RELEX_DATABASE_URL may override PG settings.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=relex
PGUSER=relex_app
PGPASSWORD=
RELEX_DATABASE_SCHEMA=relex
RELEX_QDRANT_COLLECTION=relex
# Private random value of at least 32 characters, shared by HTTP and worker.
RELEX_SESSION_SECRET=
RELEX_TRUSTED_ORIGINS=http://127.0.0.1:18080
# Explicit development opt-in; keep 0 for HTTPS deployment.
RELEX_LOOPBACK_HTTP=0
RELEX_UPLOAD_LIMIT_BYTES=10485760
RELEX_REQUEST_TIMEOUT_SECONDS=180
RELEX_TOOL_CALLS_PER_PHASE=24
RELEX_PAGES_PER_PHASE=24
RELEX_SOURCE_TOKENS_PER_PHASE=24000
