# Add your key to the private .env, never commit it.
OPENAI_API_KEY=
RELEX_MODEL_BASE_URL=https://api.openai.com/v1
RELEX_MODEL_NAME=gpt-5.4-mini
RELEX_EMBEDDING_BASE_URL=https://api.openai.com/v1
RELEX_EMBEDDING_MODEL=text-embedding-3-small
# Optional per-service key overrides; blank values fall back to OPENAI_API_KEY.
RELEX_MODEL_API_KEY=
RELEX_EMBEDDING_API_KEY=
# Service connections are selected after isolated runtime feasibility verification.
RELEX_DATABASE_URL=
RELEX_QDRANT_URL=
RELEX_QDRANT_API_KEY=
